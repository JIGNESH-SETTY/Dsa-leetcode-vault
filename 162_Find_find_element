My Approach:-
1. I will traverse the array using  the for loop from i = 1 till i = n - 1
2. if the number at i is greater than i -1 and i+1 then return i
3. we need to check at i = 1 and i = N - 1
4. and return peak element

Time complexity: O(N);
Space complexity: O(1);

My code:

class Solution {
public:
    int findPeakElement(vector<int>& nums) {
        if(nums.size() == 1){
                return 0;
            }
        if(nums[0] > nums[1]){
            return 0;
        }
        int i = 0;
        for(i = 1;i<nums.size() -1;i++){
            if(nums[i] >= nums[i-1] && nums[i] >= nums[i+1]){
                return i;
            }
        }
        if(nums[nums.size() -1] > nums[nums.size()-2]){
            return i;
        }
        return -1;
    }
};
